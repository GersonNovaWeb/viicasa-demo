{
  "name": "viicasa-demo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "emulator": "firebase emulators:start --only firestore --project demo-viicasa-preview",
    "test:social-auth": "node --test test/social-auth.test.mjs",
    "build": "node scripts/check.mjs",
    "test:safety": "node --test test/demo-safety.test.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "check": "node scripts/check.mjs",
    "test:cleaning": "node --test test/cleaning.test.mjs",
    "test:demo-catalog": "node --test viicasa-backend/test/demo-properties.test.js",
    "test:platform": "node --test viicasa-frontend-prototype/test/platform.test.mjs viicasa-frontend-prototype/test/currency.test.mjs",
    "test:registration": "node --test viicasa-backend/test/customer-registration.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "firebase-admin": "^14.3.0",
    "ip-location-api": "5.0.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {"firebase-tools": "^15.29.0"}
}
