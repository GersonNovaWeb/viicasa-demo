# Separate local Phase 2 demo. Copy to .env.phase2.local to customise.
PHASE2_MODE=demo
# staging = clean preproduction with no default users/examples; still sk_test only.
# Uses independent data/phase2-staging locally, or a fresh separate PostgreSQL pair.
# Initialise privately with npm run init:phase2-admin while its server is stopped.
PORT=3030
HOST=127.0.0.1
PHASE2_SITE_URL=http://127.0.0.1:3030
PHASE2_MAIL_MODE=outbox
PHASE2_DATABASE_DRIVER=pglite
PHASE2_RUN_ROLE=embedded
# PostgreSQL: web disables the embedded timer; worker:phase2 runs separately.
# PGlite always uses a single process. This copy remains demo, not production.

# Optional remote PostgreSQL for this demo: TWO separate empty databases.
# Keep the vault.key on persistent private storage. Never reuse production databases.
# PHASE2_DATABASE_DRIVER=postgres
# PHASE2_DATABASE_SSL=true
# PHASE2_VAULT_KEY=BASE64_OF_32_RANDOM_BYTES_KEEP_PRIVATE_AND_STABLE
# PHASE2_COMMERCIAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/viicasa_phase2_commercial
# PHASE2_PLATFORM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/viicasa_phase2_platform

# Optional Stripe sandbox. Both values must belong to this demo endpoint.
# PHASE2_STRIPE_SECRET_KEY=sk_test_REPLACE_LOCALLY
# PHASE2_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_LOCALLY
PHASE2_STRIPE_ADVANCED=false
PHASE2_STRIPE_AUTO_COLLECT=false
# Advanced sandbox requires separate approved terms and confirmed client setup.
# AUTO_COLLECT additionally executes due authorised completed-visit invoices.
# Unknown submissions are never automatically retried. sk_live is rejected.

# Optional real delivery of demo notifications. Default stores mail locally.
# PHASE2_MAIL_MODE=smtp
# PHASE2_MAIL_FROM=VIICASA <accounts@viicasa.com>
# PHASE2_ADMIN_EMAIL=gerson@novaweb-agency.com
# PHASE2_SMTP_HOST=smtp.hostinger.com
# PHASE2_SMTP_PORT=465
# PHASE2_SMTP_SECURE=true
# PHASE2_SMTP_USER=accounts@viicasa.com
# PHASE2_SMTP_PASSWORD=REPLACE_LOCALLY

# Prepared connectors. Access, explicit flags, approved scopes and validation required.
# PHASE2_LODGIFY_API_KEY=REPLACE_LOCALLY
# PHASE2_AIRBNB_ACCESS_TOKEN=REPLACE_LOCALLY
PHASE2_SHOPIFY_ENABLED=false
PHASE2_SHOPIFY_SYNC_ENABLED=false
PHASE2_SHOPIFY_CHECKOUT_APPROVED=false
PHASE2_SHOPIFY_MAIL_APPROVED=false
PHASE2_SHOPIFY_TEST_ONLY=true
PHASE2_STAY_CONNECTOR_APPROVED=false
PHASE2_STAY_MAIL_APPROVED=false
# These approvals never create a Lodgify/Airbnb bridge. An authorised API contract
# and code implementing verifyDelivery + reservation are required at connection time.
PHASE2_SHOPIFY_API_VERSION=2026-10
# PHASE2_SHOPIFY_STORE=YOUR-TEST-STORE.myshopify.com
# PHASE2_SHOPIFY_LOCATION_ID=gid://shopify/Location/REPLACE
# PHASE2_SHOPIFY_ACCESS_TOKEN=REPLACE_LOCALLY
# PHASE2_SHOPIFY_WEBHOOK_SECRET=REPLACE_LOCALLY
# PHASE2_SHOPIFY_STOREFRONT_TOKEN=REPLACE_LOCALLY
# PHASE2_SHOPIFY_CHECKOUT_HOSTS=approved-checkout-domain.example
# Signed endpoint: PHASE2_SITE_URL + /v1/webhooks/shopify
# Periodic sync reads catalogue and the last 48h of updated orders every 15min.
# Shopify's store settings control actual charges; authorise a test store only.
PHASE2_GA4_ENABLED=false
PHASE2_META_ENABLED=false
PHASE2_GTM_ENABLED=false
PHASE2_GTM_CONTAINER_APPROVED=false
# PHASE2_META_PIXEL_ID=REPLACE_LOCALLY
# PHASE2_META_ACCESS_TOKEN=REPLACE_LOCALLY
# PHASE2_META_GRAPH_VERSION=APPROVED_PROVIDER_VERSION
# PHASE2_META_TEST_EVENT_CODE=REPLACE_LOCALLY
# PHASE2_GA4_MEASUREMENT_ID=REPLACE_LOCALLY
# PHASE2_GA4_API_SECRET=REPLACE_LOCALLY
# PHASE2_GTM_CONTAINER_ID=REPLACE_LOCALLY
# Choose browser GTM OR direct GA4/Meta, never both. Sharing requires fresh consent.
# Admin: Measurement > external data-sharing approval is separate from local privacy.

# Optional encrypted PostgreSQL backup (separate key, NOT your vault key).
# Requires pg_dump/pg_restore clients and two stopped databases for a matched pair.
# PHASE2_BACKUP_KEY=SEPARATE_BASE64_32_RANDOM_BYTES
# PHASE2_RESTORE_COMMERCIAL_URL=postgresql://USER:PASSWORD@HOST:5432/empty_demo_commercial
# PHASE2_RESTORE_PLATFORM_URL=postgresql://USER:PASSWORD@HOST:5432/empty_demo_platform

# Customer identity only, NEVER commercial/admin access. Disabled until configured.
PHASE2_GOOGLE_ENABLED=false
PHASE2_APPLE_ENABLED=false
# PHASE2_GOOGLE_CLIENT_ID=REPLACE_LOCALLY
# PHASE2_GOOGLE_CLIENT_SECRET=REPLACE_LOCALLY
# Register EXACT callback: PHASE2_SITE_URL + /auth/google/callback
# PHASE2_APPLE_SERVICE_ID=REPLACE_LOCALLY
# PHASE2_APPLE_TEAM_ID=REPLACE_LOCALLY
# PHASE2_APPLE_KEY_ID=REPLACE_LOCALLY
# PHASE2_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_LOCALLY\n-----END PRIVATE KEY-----"
# Apple requires an authorised HTTPS domain (NOT localhost/IP).
# Register EXACT callback: PHASE2_SITE_URL + /auth/apple/callback
